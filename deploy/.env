APP_ENV=dev
API_PREFIX=/api
LOG_LEVEL=INFO
TZ=UTC
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
JWT_SECRET=change_me_dev_secret
JWT_EXPIRES_HOURS=12
SOCKETIO_PATH=/api/ws/dashboard
WS_ALLOW_ORIGINS=*
ROBOT_TOKEN_PREFIX=robot_token_
LOW_BATTERY_THRESHOLD=20
ROBOT_OFFLINE_SECONDS=60
AI_BASE_URL=http://ai-service:4000
AI_TIMEOUT_SECONDS=10
AI_CACHE_TTL_SECONDS=300
CSV_DELIMITER=;
CSV_ENCODING=UTF-8
MAX_UPLOAD_MB=25
EXPORT_EXCEL_SHEET=Inventory
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RATE_LIMIT_ROBOT_RPS=5
SEED_USER_EMAIL=operator@example.com
SEED_USER_PASSWORD=password1234
SEED_USER_NAME=Оператор
SEED_USER_ROLE=operator
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=warehouse_db
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=warehouse_password
DATABASE_URL=postgresql+psycopg://warehouse_user:warehouse_password@postgres:5432/warehouse_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://redis:6379/0
AI_HOST=0.0.0.0
AI_PORT=4000
FRONTEND_PORT=8080
ROBOTS_COUNT=5
UPDATE_INTERVAL=10
API_URL=http://backend:3000
